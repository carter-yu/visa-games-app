    "shape_groups": {
      "c_family": ["c", "o", "e", "a", "d", "g", "q"],
      "arch": ["n", "m", "h", "r", "u"],
      "stick": ["i", "l", "j", "t", "f", "k"],
      "slant": ["v", "w", "x", "y", "z", "k"]
    },
    "tags": {
      "open_closed": [["c", "o"], ["c", "e"]],
      "stick_length": [["a", "d"]],
      "has_stick": [["c", "a"], ["c", "d"], ["c", "b"]]
    }
  },

